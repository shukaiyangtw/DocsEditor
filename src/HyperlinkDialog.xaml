<Window x:Class="DocsEditor.HyperlinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocsEditor"
        xmlns:p="clr-namespace:DocsEditor.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.TextAndUrl}" Icon="/DocsEditor.ico"
        Height="250" Width="500" Background="WhiteSmoke">

    <StackPanel Orientation="Vertical" Margin="16">
        <TextBlock Style="{StaticResource TextBoxLabelStyle}" Text="{x:Static p:Resources.HyperlinkText}" />
        <TextBox x:Name="HyperlinkTextBox" />

        <TextBlock Style="{StaticResource TextBoxLabelStyle}" Text="{x:Static p:Resources.HyperlinkUrl}" />
        <TextBox x:Name="UrlTextBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">

            <Button x:Name="OkButton" Style="{StaticResource TextButtonStyle}" Click="OkButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE10B;" FontSize="14" Margin="4 0" />
                    <TextBlock Text="{x:Static p:Resources.OK}" />
                </StackPanel>
            </Button>

            <Button x:Name="CancelButton" Style="{StaticResource TextButtonStyle}" Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE10A;" FontSize="14" Margin="4 0" />
                    <TextBlock Text="{x:Static p:Resources.Cancel}" />
                </StackPanel>
            </Button>

        </StackPanel>

        <TextBlock x:Name="MessageLabel" Foreground="DarkRed" FontSize="16" HorizontalAlignment="Center" />
    </StackPanel>    
    
</Window>
